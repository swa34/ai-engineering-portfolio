{
	"name": "graduation-announcement-demo",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.21.0 <25 || >=26.8.2 <27"
	},
	"scripts": {
		"dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
		"test:browser": "playwright test",
		"build": "npm run typecheck && vite build",
		"start": "NODE_ENV=production node --import tsx server/index.ts",
		"check": "npm run typecheck && npm run lint && npm test && npm run build"
	},
	"dependencies": {
		"better-sqlite3": "13.0.3",
		"express": "5.2.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"zod": "4.6.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.5.13",
		"@playwright/test": "1.63.0",
		"@types/better-sqlite3": "9.6.0",
		"@types/express": "5.0.6",
		"@types/node": "22.20.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/supertest": "7.2.1",
		"@vitejs/plugin-react": "6.1.1",
		"concurrently": "10.0.5",
		"supertest": "7.2.2",
		"tsx": "4.23.13",
		"typescript": "7.0.2",
		"vite": "8.3.0"
	}
}
